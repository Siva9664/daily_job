# ─────────────────────────────────────────────────────────────
#  daily-job-internship-alerts — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit your real .env file — it is already in .gitignore
# ─────────────────────────────────────────────────────────────

# ── Sender Gmail address ──────────────────────────────────────
# This is the Gmail account that SENDS the digest email.
EMAIL_FROM=your_gmail@gmail.com

# ── Gmail App Password ────────────────────────────────────────
# Do NOT use your real Gmail password here!
# Generate an App Password from:
#   https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on your account)
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ── Recipients (comma-separated) ─────────────────────────────
# The people who will RECEIVE the daily digest email.
# Can be different from EMAIL_FROM.
EMAIL_TO=recipient1@gmail.com,recipient2@gmail.com

# ── Keyword Filter (optional) ─────────────────────────────────
# Leave blank to receive ALL jobs from all sources.
# Add comma-separated keywords to only receive matching jobs.
# Matching is case-insensitive and checked against title,
# company name, description, and tags.
#
# Examples:
#   KEYWORDS=python,data,machine learning
#   KEYWORDS=frontend,react,javascript
#   KEYWORDS=marketing,content
KEYWORDS=

# ── LinkedIn Guest Endpoint (optional / experimental) ─────────
# Enable fetching jobs from LinkedIn's public guest search API (past 24h).
# Default: false
# NOTE & WARNING:
# This endpoint is unofficial, subject to aggressive rate limits (HTTP 429),
# and may violate LinkedIn's Terms of Service. Use strictly for personal alerts.
ENABLE_LINKEDIN=false
